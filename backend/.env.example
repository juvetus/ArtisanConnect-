# Database
DATABASE_URL=postgresql://artisan:artisan_password_dev@localhost:5432/artisan_connect
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=artisan
DB_PASSWORD=artisan_password_dev
DB_DATABASE=artisan_connect

# Server
NODE_ENV=development
PORT=3001
API_URL=http://localhost:3001

# JWT
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRATION=7d

ADMIN_EMAIL=admin@artisanconnect.cm
ADMIN_PASSWORD=change_this_admin_password
ADMIN_NAME=Administration ArtisanConnect

# Frontend
FRONTEND_URL=http://localhost:3000

ORANGE_MONEY_MODE=disabled

# Email (Brevo/SendGrid - optional for MVP)
SMTP_HOST=smtp.brevo.com
SMTP_PORT=587
SMTP_USER=your_email@example.com
SMTP_PASSWORD=your_password

# File Upload (S3 - optional for MVP)
AWS_ACCESS_KEY_ID=your_aws_key
AWS_SECRET_ACCESS_KEY=your_aws_secret
AWS_S3_BUCKET=artisan-connect-images
AWS_S3_REGION=eu-west-1
