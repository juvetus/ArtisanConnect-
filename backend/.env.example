# Database
DATABASE_URL=postgresql://artisan:artisan_password_dev@localhost:5432/artisan_connect
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=artisan
DB_PASSWORD=artisan_password_dev
DB_DATABASE=artisan_connect

# Server
NODE_ENV=development
PORT=3001
API_URL=http://localhost:3001
DB_SYNCHRONIZE=true

# JWT
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRATION=7d

ADMIN_EMAIL=admin@artisanconnect.cm
ADMIN_PASSWORD=change_this_admin_password
ADMIN_NAME=Administration ArtisanConnect

# Frontend
FRONTEND_URL=http://localhost:3000

# Assistant IA ArtisanConnect (optionnel : le mode brouillon local reste disponible sans clé)
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# Paiements - Phase pilote contrôlée
# Espèces : réel, aucun identifiant externe requis.
# MoMo et Orange Money restent en mock jusqu'à réception/validation des clés API.

# MTN MoMo API
MOMO_MODE=mock
MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com
MOMO_TARGET_ENVIRONMENT=sandbox
MOMO_API_USER=
MOMO_API_KEY=
MOMO_SUBSCRIPTION_KEY=
# Secret partagé utilisé pour vérifier les callbacks HMAC SHA-256 via x-momo-signature ou x-signature.
MOMO_WEBHOOK_SECRET=change_this_momo_webhook_secret

# Orange Money API
ORANGE_MONEY_MODE=mock
ORANGE_MONEY_CLIENT_ID=
ORANGE_MONEY_CLIENT_SECRET=
ORANGE_MONEY_MERCHANT_KEY=
ORANGE_MONEY_BASE_URL=https://api.orange.com

# Email transactionnel (Brevo SMTP)
# Pour le pilote : activer avec de vrais identifiants SMTP.
SMTP_ENABLED=true
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_brevo_smtp_login
SMTP_PASSWORD=your_brevo_smtp_key
SMTP_FROM=ArtisanConnect <no-reply@artisanconnect.cm>

# Stockage Cloudinary (recommande en production)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# File Upload (S3 - optional for MVP)
AWS_ACCESS_KEY_ID=your_aws_key
AWS_SECRET_ACCESS_KEY=your_aws_secret
AWS_S3_BUCKET=artisan-connect-images
AWS_S3_REGION=eu-west-1

# Transporteur / Gozem - Phase pilote en simulation tant que l'API réelle n'est pas validée.
CARRIER_PROVIDER=Gozem
CARRIER_API_URL=https://api.gozem.co/v1
CARRIER_API_KEY=
# Secret partagé utilisé pour vérifier les webhooks HMAC SHA-256 via x-gozem-signature, x-carrier-signature ou x-signature.
CARRIER_WEBHOOK_SECRET=change_this_carrier_webhook_secret
