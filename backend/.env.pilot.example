# ArtisanConnect - Configuration phase pilote contrôlée
# Copier vers backend/.env sur l'environnement pilote, puis remplacer toutes les valeurs change_this/your_*.

# Runtime
NODE_ENV=production
PORT=3001
API_URL=https://api-pilote.artisanconnect.cm
FRONTEND_URL=https://pilote.artisanconnect.cm

# Database
DATABASE_URL=postgresql://user:password@host:5432/artisan_connect
DB_HOST=host
DB_PORT=5432
DB_USERNAME=user
DB_PASSWORD=password
DB_DATABASE=artisan_connect
DB_SYNCHRONIZE=false
DB_RETRY_ATTEMPTS=5
DB_RETRY_DELAY=3000

# Auth / Admin
JWT_SECRET=change_this_with_a_long_random_secret
JWT_EXPIRATION=7d
ADMIN_EMAIL=admin@artisanconnect.cm
ADMIN_PASSWORD=change_this_admin_password
ADMIN_NAME=Administration ArtisanConnect

# Paiements phase pilote
# Espèces : réel.
# MoMo / Orange Money : mock jusqu'à réception et validation des clés API.
MOMO_MODE=mock
MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com
MOMO_API_USER=
MOMO_API_KEY=
MOMO_SUBSCRIPTION_KEY=
MOMO_WEBHOOK_SECRET=change_this_momo_webhook_secret

ORANGE_MONEY_MODE=mock
ORANGE_MONEY_CLIENT_ID=
ORANGE_MONEY_CLIENT_SECRET=
ORANGE_MONEY_MERCHANT_KEY=
ORANGE_MONEY_BASE_URL=https://api.orange.com

# Transporteur phase pilote
# Gozem reste en simulation tant que l'accès API réel n'est pas validé.
CARRIER_PROVIDER=Gozem
CARRIER_API_URL=https://api.gozem.co/v1
CARRIER_API_KEY=
CARRIER_WEBHOOK_SECRET=change_this_carrier_webhook_secret

# Email transactionnel réel obligatoire pour le pilote
SMTP_ENABLED=true
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_brevo_smtp_login
SMTP_PASSWORD=your_brevo_smtp_key
SMTP_FROM=ArtisanConnect <no-reply@artisanconnect.cm>

# Stockage fichiers / images / KYC facultatif
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# S3 optionnel
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_S3_REGION=
